{
  "manifest_version": 3,
  "name": "GenClass: voice control for your browser",
  "short_name": "GenClass",
  "version": "0.1.0",
  "description": "Talk to your browser and it acts mid-sentence. A local AI model runs on your device. Independent project; not affiliated with TypeSafe.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "GenClass", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["sidePanel", "offscreen", "storage", "scripting", "alarms", "system.memory"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "commands": {
    "toggle-listening": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Start or stop listening" },
    "kill-switch": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Stop everything GenClass is doing" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
