{
  "version": 1,
  "about": "20 hand-written Mac harness cases for the decoder engine (CONTRACT C). Each case is a transcript spoken over one screen; the request is built with harness.state.build_state + harness.questions.build_questions exactly as at runtime. expect.intent is the first command's intent; expect.target is the gold element eid, or 'none' when the command does not act on an element; expect.app is the named application or 'none'; expect.complete / expect.is_command are the gold noul answers (side talk is incomplete and not a command), all following CONTRACT D label semantics. 'safari_news' has exactly 60 elements and is the 60-element benchmark screen.",
  "apps": [
    "Safari", "Google Chrome", "Firefox", "Mail", "Messages", "Notes", "Reminders", "Calendar", "Photos",
    "Music", "Spotify", "Slack", "Zoom", "Finder", "TextEdit", "Preview", "Pages", "Numbers", "Keynote",
    "Xcode", "Visual Studio Code", "Terminal", "System Settings", "App Store", "Maps", "Weather", "Calculator",
    "FaceTime", "Contacts", "Podcasts", "News", "Stocks", "Books", "Discord", "WhatsApp", "Notion",
    "Figma", "Microsoft Word", "Microsoft Excel", "1Password"
  ],
